{
  "cli": {
    "version": ">= 0.60.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_BASE_URL": "https://frontdesk.getomnify.info"
      }
    },
    "staging": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_BASE_URL": "https://frontdesk.getomnify.info"
      }
    },
    "preprod": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "APP_ENV": "preprod",
        "EXPO_PUBLIC_BASE_URL": "https://frontdesk.getomnify.io"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_BASE_URL": "https://admin.getomnify.ai"
      }
    }
  },
  "submit": {
    "staging": {},
    "preprod": {},
    "production": {}
  }
}